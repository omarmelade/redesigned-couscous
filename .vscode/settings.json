{
  "workbench.startupEditor": "readme",
  "files.exclude": {
    "**/__pycache__": true,
    ".github": true,
    ".vscode": true,
    ".gitattributes": true,
    ".gitignore": true,
    ".nvim.lua": true,
    "*.py": true,
    "_story.twee": true,
    "17 octobre.twee": true
  },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.fontSize": 16,
    "editor.lineHeight": 26,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false
    },
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.renderWhitespace": "trailing"
  },
  "cSpell.language": "fr,en",
  "cSpell.enabledFileTypes": {
    "markdown": true
  },
  "cSpell.ignoreRegExpList": [
    "/^---[\\s\\S]*?---/",
    "/\\[\\[.*?\\]\\]/g",
    "/→.*$/gm"
  ]
}
